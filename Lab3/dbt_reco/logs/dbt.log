[0m09:07:07.130573 [debug] [Thread-1 (]: On model.reco.item_popularity: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "reco", "target_name": "dev", "node_id": "model.reco.item_popularity"} */

    

    create  table
      "warehouse"."main"."item_popularity__dbt_tmp"
  
    
    as (
      -- Популярность товаров в категории за окно window_days до момента as_of (модель popular_in_category из ЛР-1):
-- главный критерий - число покупок (плюс корзины с весом cart_weight), при равенстве - корзины и просмотры
with w as (
    select *
    from "warehouse"."main"."stg_events"
    where event_time >= cast('2019-10-03 00:00:00' as timestamp) - interval 10 day
      and event_time < cast('2019-10-03 00:00:00' as timestamp)
), agg as (
    select
        product_id,
        arg_max(category_id, event_time) as category_id,
        count(*) filter (where event_type = 'purchase') as n_purchases,
        count(*) filter (where event_type = 'cart') as n_carts,
        count(*) filter (where event_type = 'view') as n_views
    from w
    group by product_id
)
select
    *,
    n_purchases + 0 * n_carts as score,
    row_number() over (partition by category_id order by n_purchases + 0 * n_carts desc,
                       n_carts desc, n_views desc, product_id) as rank_in_category,
    row_number() over (order by n_purchases + 0 * n_carts desc,
                       n_carts desc, n_views desc, product_id) as global_rank
from agg
    );
    
  
