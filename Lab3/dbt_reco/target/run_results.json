.\"main\".\"dim_products\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-10T02:16:19.095688Z", "completed_at": "2026-10-10T02:16:19.097527Z"}, {"name": "execute", "started_at": "2026-10-10T02:16:19.097914Z", "completed_at": "2026-10-10T02:16:19.159115Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.06480097770690918, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.reco.dim_users", "compiled": true, "compiled_code": "-- \u0418\u0437\u043c\u0435\u0440\u0435\u043d\u0438\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0435\u0439: \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0438 \u0441\u0440\u0435\u0434\u043d\u0438\u0439 \u0447\u0435\u043a\nselect\n    user_id,\n    min(event_time) as first_seen,\n    max(event_time) as last_seen,\n    count(*) as n_events,\n    count(*) filter (where event_type = 'view') as n_views,\n    count(*) filter (where event_type = 'cart') as n_carts,\n    count(*) filter (where event_type = 'purchase') as n_purchases,\n    coalesce(sum(price) filter (where event_type = 'purchase'), 0) as revenue_usd,\n    sum(price) filter (where event_type = 'purchase') / nullif(count(distinct user_session) filter (where event_type = 'purchase'), 0)\n        as avg_check_usd\nfrom \"warehouse\".\"main\".\"stg_events\"\ngroup by user_id", "relation_name": "\"warehouse\".\"main\".\"dim_users\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-10T02:16:19.163005Z", "completed_at": "2026-10-10T02:16:19.167261Z"}, {"name": "execute", "started_at": "2026-10-10T02:16:19.167730Z", "completed_at": "2026-10-10T02:16:19.207777Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04612994194030762, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.reco.fact_sales", "compiled": true, "compiled_code": "-- \u0424\u0430\u043a\u0442 \u043f\u0440\u043e\u0434\u0430\u0436: \u043e\u0434\u043d\u0430 \u0441\u0442\u0440\u043e\u043a\u0430 = \u043e\u0434\u043d\u0430 \u043f\u043e\u043a\u0443\u043f\u043a\u0430 \u0442\u043e\u0432\u0430\u0440\u0430\nselect\n    idempotency_key as sale_id,\n    event_time,\n    event_date,\n    user_id,\n    product_id,\n    category_id,\n    category_l1,\n    brand,\n    price as amount_usd,\n    round(price * 84.43, 2) as amount_rub\nfrom \"warehouse\".\"main\".\"stg_events\"\nwhere event_type = 'purchase'", "relation_name": "\"warehouse\".\"main\".\"fact_sales\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-10T02:16:19.211775Z", "completed_at": "2026-10-10T02:16:19.214498Z"}, {"name": "execute", "started_at": "2026-10-10T02:16:19.214916Z", "completed_at": "2026-10-10T02:16:19.287464Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.07706046104431152, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.reco.item_popularity", "compiled": true, "compiled_code": "-- \u041f\u043e\u043f\u0443\u043b\u044f\u0440\u043d\u043e\u0441\u0442\u044c \u0442\u043e\u0432\u0430\u0440\u043e\u0432 \u0432 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438 \u0437\u0430 \u043e\u043a\u043d\u043e window_days \u0434\u043e \u043c\u043e\u043c\u0435\u043d\u0442\u0430 as_of (\u043c\u043e\u0434\u0435\u043b\u044c popular_in_category \u0438\u0437 \u041b\u0420-1):\n-- \u0433\u043b\u0430\u0432\u043d\u044b\u0439 \u043a\u0440\u0438\u0442\u0435\u0440\u0438\u0439 - \u0447\u0438\u0441\u043b\u043e \u043f\u043e\u043a\u0443\u043f\u043e\u043a (\u043f\u043b\u044e\u0441 \u043a\u043e\u0440\u0437\u0438\u043d\u044b \u0441 \u0432\u0435\u0441\u043e\u043c cart_weight), \u043f\u0440\u0438 \u0440\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0435 - \u043a\u043e\u0440\u0437\u0438\u043d\u044b \u0438 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u044b\nwith w as (\n    select *\n    from \"warehouse\".\"main\".\"stg_events\"\n    where event_time >= cast('2019-10-01 12:00:00' as timestamp) - interval 10 day\n      and event_time < cast('2019-10-01 12:00:00' as timestamp)\n), agg as (\n    select\n        product_id,\n        arg_max(category_id, event_time) as category_id,\n        count(*) filter (where event_type = 'purchase') as n_purchases,\n        count(*) filter (where event_type = 'cart') as n_carts,\n        count(*) filter (where event_type = 'view') as n_views\n    from w\n    group by product_id\n)\nselect\n    *,\n    n_purchases + 0 * n_carts as score,\n    row_number() over (partition by category_id order by n_purchases + 0 * n_carts desc,\n                       n_carts desc, n_views desc, product_id) as rank_in_category,\n    row_number() over (order by n_purchases + 0 * n_carts desc,\n                       n_carts desc, n_views desc, product_id) as global_rank\nfrom agg", "relation_name": "\"warehouse\".\"main\".\"item_popularity\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-10T02:16:19.291556Z", "completed_at": "2026-10-10T02:16:19.297239Z"}, {"name": "execute", "started_at": "2026-10-10T02:16:19.297697Z", "completed_at": "2026-10-10T02:16:19.306894Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.017760038375854492, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.reco.not_null_dim_products_product_id.c8aba288d1", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect product_id\nfrom \"warehouse\".\"main\".\"dim_products\"\nwhere product_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-10T02:16:19.311633Z", "completed_at": "2026-10-10T02:16:19.317407Z"}, {"name": "execute", "started_at": "2026-10-10T02:16:19.317817Z"